# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Event-driven cognition (all processing is local unless a goal explicitly
# invokes the configured model router).
MYRAA_ENABLE_COGNITION=true
MYRAA_ENABLE_INITIATIVE=true
MYRAA_ENABLE_PROACTIVE_SPEECH=true
MYRAA_ENABLE_SKILL_LEARNING=true
MYRAA_ENABLE_REFLECTION=true
MYRAA_ENABLE_DESKTOP_AWARENESS=true
MYRAA_ENABLE_SCREEN_AWARENESS=false
PAUSE_AUTONOMY=false
MYRAA_COGNITION_DEBUG=false

# Model capability routes. Comma-separate one fallback at most.
MYRAA_FAST_MODEL=gemini-3.5-flash
MYRAA_REASONING_MODEL=gemini-3.5-flash
MYRAA_CODE_MODEL=gemini-3.5-flash
MYRAA_VISION_MODEL=gemini-3.1-flash-live-preview
MYRAA_EMBEDDING_MODEL=gemini-embedding-001
MYRAA_SPEECH_MODEL=gemini-3.1-flash-live-preview

# Explicit local capability permissions.
MYRAA_PERMISSION_MICROPHONE=true
MYRAA_PERMISSION_SCREEN_AWARENESS=true
MYRAA_PERMISSION_FILESYSTEM_READ=true
MYRAA_PERMISSION_FILESYSTEM_WRITE=true
MYRAA_PERMISSION_DESKTOP_CONTROL=true
MYRAA_PERMISSION_BROWSER=true
MYRAA_PERMISSION_NETWORK=true
MYRAA_PERMISSION_AUTOMATION=true
MYRAA_PERMISSION_CODE_EXECUTION=true
MYRAA_PERMISSION_SYSTEM_CONTROL=true

# Runaway/cost limits.
MYRAA_MAX_PLAN_DEPTH=8
MYRAA_MAX_RETRIES=2
MYRAA_MAX_TOOL_CALLS=24
MYRAA_TASK_TIMEOUT_MS=300000
MYRAA_REPETITION_COOLDOWN_MS=180000

# Public API capability catalogue (backend-only; providers are not all exposed to the model)
MYRAA_API_CATALOGUE_SYNC=true
MYRAA_PUBLIC_APIS_URL=https://raw.githubusercontent.com/public-apis/public-apis/master/README.md
MYRAA_API_CATALOGUE_MAX_AGE_MS=86400000
MYRAA_API_HEALTH_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Mobile / remote access (OPTIONAL — off by default)
# ---------------------------------------------------------------------------
# Sara's server normally binds to 127.0.0.1 and refuses anything that is not
# from this computer. The phone app needs a way in. Turn that on only when you
# understand the trade-off, and always behind HTTPS (a tunnel or reverse proxy).
#
# SARA_REMOTE_ACCESS=1
# SARA_ACCESS_TOKEN=            # required; >= 24 chars. openssl rand -hex 32
# SARA_ALLOWED_ORIGINS=https://your-web-app.vercel.app,https://your-tunnel.example.com
# SARA_HOST=0.0.0.0             # default when remote access is on
# SARA_TRUST_PROXY=1            # when a reverse proxy terminates TLS in front
# SARA_REMOTE_ALLOW_DESKTOP=0   # 1 lets a phone trigger PC automation; off by default
#
# Call integration (see docs/COMMUNICATION.md). The Android app must send the
# same token; without it the server refuses call events with 503.
# SARA_CALL_DEVICE_TOKEN=       # >= 24 chars. openssl rand -hex 32
#
# Messaging (official WhatsApp Cloud API only; there is no scraping fallback).
# Without these the WhatsApp connector reports NOT_SUPPORTED instead of failing
# silently. Inbound messages need a public webhook URL plus the app secret.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# The port the backend listens on (PORT also works on hosting platforms).
# MYRAA_PORT=3000
