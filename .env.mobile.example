# Frontend build-time configuration for mobile/static deployments.
#
# Everything here is PUBLIC: it is compiled into the JavaScript bundle.
# Never put an API key or an access token in a VITE_* variable.
#
# The Gemini key stays on the Sara server (Settings → API key).
# The access token is typed by the user on their own device (Connect screen).

# Optional: the Sara backend this build should talk to by default.
# Leave empty to use the same origin (desktop app and local browser).
# You can also edit public/runtime-config.js on the host after deploying.
# VITE_SARA_API_BASE=https://sara.example.com

# Optional: build the public installer behaviour (no bundled character).
# VITE_MYRAA_PUBLIC=1
